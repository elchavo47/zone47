@echo off
chcp 65001 >nul
setlocal
set "PROJ=%~dp0"
if "%PROJ:~-1%"=="\" set "PROJ=%PROJ:~0,-1%"
set "PATH=%PATH%;C:\Program Files\Git\cmd"
if not exist "%PROJ%\Assets\Zone47" (echo HATA: Bu bat proje klasorunde degil. Bat'i Assets ve ios klasorlerinin oldugu klasore koy, orada calistir. Simdiki yer: %PROJ% & pause & exit /b 1)
echo === Zone 47 GitHub yukleme ===
cd /d "%PROJ%" || (echo Proje klasoru yok: %PROJ% & pause & exit /b 1)

echo [1/7] Visual Studio kapatiliyor...
taskkill /IM devenv.exe /F >nul 2>&1

echo [2/7] .gitignore yaziliyor...
(
echo # Unity
echo /[Ll]ibrary/
echo /[Tt]emp/
echo /[Oo]bj/
echo /[Bb]uild/
echo /[Bb]uilds/
echo /[Ll]ogs/
echo /[Uu]ser[Ss]ettings/
echo /[Mm]emoryCaptures/
echo /[Rr]ecordings/
echo *.csproj
echo *.sln
echo *.slnx
echo *.suo
echo *.user
echo *.pidb
echo *.booproj
echo *.unityproj
echo .vs/
echo .idea/
echo .DS_Store
echo Thumbs.db
echo *.apk
echo *.aab
echo *.ipa
echo.
echo # iOS export
echo *_BurstDebugInformation_DoNotShip/
echo ios/Libraries/libiPhone-lib.a
) > .gitignore
if exist .gitattributes del /q .gitattributes

echo [2b/7] Workflow dosyasi yaziliyor...
if not exist .github\workflows mkdir .github\workflows
if exist "%TEMP%\z47wf.b64" del /q "%TEMP%\z47wf.b64"
>>"%TEMP%\z47wf.b64" echo 
>>"%TEMP%\z47wf.b64" echo 
>>"%TEMP%\z47wf.b64" echo 
>>"%TEMP%\z47wf.b64" echo 
powershell -NoProfile -Command "$b=(Get-Content \"$env:TEMP\z47wf.b64\") -join ''; [IO.File]::WriteAllBytes('%PROJ%\.github\workflows\ios-xcode-testflight.yml',[Convert]::FromBase64String($b))"
if exist .github\workflows\ios-testflight.yml del /q .github\workflows\ios-testflight.yml

echo [3/7] Kopya Zone47 klasoru temizleniyor...
if exist "%PROJ%\Zone47\Scripts" if exist "%PROJ%\Assets\Zone47\Scripts" rmdir /s /q "%PROJ%\Zone47"

echo [4/7] Xcode projesi ios klasorune tasiniyor...
if exist "C:\Users\4747\zonee\Unity-iPhone.xcodeproj" (
  if exist "%PROJ%\ios" rmdir /s /q "%PROJ%\ios"
  move "C:\Users\4747\zonee" "%PROJ%\ios" >nul
)
if not exist "%PROJ%\ios\Unity-iPhone.xcodeproj" (echo HATA: ios\Unity-iPhone.xcodeproj bulunamadi. Unity den iOS build al. & pause & exit /b 1)
if exist "%PROJ%\ios\Zone 47_BurstDebugInformation_DoNotShip" rmdir /s /q "%PROJ%\ios\Zone 47_BurstDebugInformation_DoNotShip"

echo [5/7] libiPhone-lib.a sikistiriliyor (biraz surer)...
powershell -NoProfile -Command "Compress-Archive -Path '%PROJ%\ios\Libraries\libiPhone-lib.a' -DestinationPath '%PROJ%\ios\Libraries\libiPhone-lib.zip' -CompressionLevel Optimal -Force; $s=(Get-Item '%PROJ%\ios\Libraries\libiPhone-lib.zip').Length/1MB; Write-Host ('   zip boyutu: {0:N1} MB' -f $s); if ($s -ge 99) { Write-Host '   UYARI: 100 MB ustu, Claude a soyle!' -ForegroundColor Red; exit 1 }"
if errorlevel 1 (pause & exit /b 1)

echo [5b/7] 100 MB ustu dosyalar parcalaniyor...
powershell -NoProfile -Command "Get-ChildItem -Path '%PROJ%\ios' -Recurse -Filter '*.z47part*' | Remove-Item -Force; Get-ChildItem -Path '%PROJ%\ios' -Recurse -File | Where-Object { $_.Length -gt 95MB -and $_.Name -ne 'libiPhone-lib.a' } | ForEach-Object { $f=$_.FullName; $fs=[IO.File]::OpenRead($f); $buf=New-Object byte[] (90MB); $i=0; while(($n=$fs.Read($buf,0,$buf.Length)) -gt 0){ $out=$f+'.z47part'+$i.ToString('00'); $o=[IO.File]::Create($out); $o.Write($buf,0,$n); $o.Close(); $i++ }; $fs.Close(); Remove-Item $f; Write-Host ('   ' + $_.Name + ' -> ' + $i + ' parca') }"
if errorlevel 1 (pause & exit /b 1)

echo [6/7] Git hazirlaniyor...
if not exist .git git init >nul
git branch -M main
git remote remove origin >nul 2>&1
git remote add origin https://github.com/elchavo47/zone47.git
git fetch -q origin main >nul 2>&1
git reset -q --soft origin/main >nul 2>&1
git rm -r --cached . -q >nul 2>&1
git add -A
git commit -q -m "Zone 47 iOS build"
echo    Eklenen ust klasorler:
powershell -NoProfile -Command "git ls-files | ForEach-Object { ($_ -split '/')[0] } | Sort-Object -Unique | ForEach-Object { '     ' + $_ }"

echo [7/7] GitHub a gonderiliyor...
git config http.postBuffer 524288000
git push -u origin main
if errorlevel 1 (echo. & echo HATA: push basarisiz, ekran goruntusunu Claude a at. & pause & exit /b 1)
echo.
echo TAMAM! Simdi GitHub da Actions sekmesinden workflow u calistirabilirsin.
pause
